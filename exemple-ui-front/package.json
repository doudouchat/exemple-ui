{
  "name": "exemple-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --aot=false",
    "test": "ng test --no-watch",
    "test:dev": "ng test --watch --progress",
    "lint": "ng lint exemple-ui",
    "e2e": "ng e2e",
    "e2e:stub": "ng e2e --configuration=stub --browser chrome",
    "e2e:dev": "ng e2e --watch=false --headless=false --configuration=dev --browser chrome",
    "e2e:docker": "ng e2e --configuration=docker --browser chrome",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/localize": "^21.2.22",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.22",
    "@angular/router": "^21.2.22",
    "@ngxs/router-plugin": "^21.0.0",
    "@ngxs/storage-plugin": "^21.0.0",
    "@ngxs/store": "^21.0.0",
    "fast-json-patch": "^3.1.1",
    "moment": "^2.30.1",
    "ngx-mask": "^21.1.0",
    "node-forge": "^1.4.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.22",
    "@angular/language-service": "^21.2.22",
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@cypress/schematic": "^6.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^21.4.0",
    "cassandra-driver": "^4.9.0",
    "cypress": "^16.0.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "ng-mocks": "^14.17.3",
    "sonarqube-scanner": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "stepDefinitions": [
      "e2e/steps/*.ts"
    ]
  }
}
